{
  "expo": {
    "name": "Optical Rx Now",
    "slug": "optical-rx-now",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "opticalrxnow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opticalrxnow.mobile.v1",
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of your prescriptions to store them",
        "NSPhotoLibraryUsageDescription": "Import prescription photos from your gallery",
        "NSPhotoLibraryAddUsageDescription": "Save prescription images to your gallery",
        "NSLocationWhenInUseUsageDescription": "Find nearby optical stores for eyewear shopping",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["mailto", "maps", "tel"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.opticalrxnow.mobile.v1",
      "versionCode": 3,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.opticalrxnow.mobile.v1",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#0A1628",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withFollyFix.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static",
            "ccacheEnabled": false,
            "extraPods": [],
            "newArchEnabled": false
          },
          "android": {
            "minSdkVersion": 24,
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Import prescription photos from your gallery",
          "cameraPermission": "Take photos of your prescriptions to store them"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find nearby optical stores for eyewear shopping"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://opticalrxnow.com/privacy",
      "supportEmail": "support@OpticalRxNow.com",
      "websiteUrl": "https://opticalrxnow.com",
      "router": {}
    },
    "owner": "alamotte1956"
  }
}
