{
  "expo": {
    "name": "My Optical Wallet",
    "slug": "optical-rx-now",
    "version": "2.1.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": ["opticalrxnow", "snssdk1233"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opticalrxnow.mobile.v1",
      "buildNumber": "35",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Capture photos of optical documents to store locally",
        "NSPhotoLibraryUsageDescription": "Import optical document photos from your gallery",
        "NSPhotoLibraryAddUsageDescription": "Save optical document images to your gallery",
        "NSLocationWhenInUseUsageDescription": "Find nearby optical stores for eyewear shopping",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "mailto",
          "maps",
          "tel"
        ],
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "22mmun2rn5.skadnetwork" }
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.opticalrxnow.mobile.v1",
      "versionCode": 9,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.opticalrxnow.mobile.v1",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_APP_BADGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withRemovePermissions",
      "./plugins/withNetworkSecurity",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select and store images of your optical documents locally.",
          "microphonePermission": false,
          "cameraPermission": "Capture photos of your optical documents to store them locally."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find nearby optical stores for eyewear shopping"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "usesCleartextTraffic": true,
            "blockedPermissions": [
              "android.permission.READ_MEDIA_IMAGES",
              "android.permission.READ_MEDIA_VIDEO",
              "android.permission.READ_EXTERNAL_STORAGE",
              "android.permission.WRITE_EXTERNAL_STORAGE"
            ]
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-mail-composer",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://MyOpticalWallet.com/privacy",
      "supportEmail": "alamotte1956@gmail.com",
      "websiteUrl": "https://MyOpticalWallet.com",
      "EXPO_PUBLIC_BACKEND_URL": "https://optical-rx-now-production.up.railway.app",
      "router": {}
    },
    "owner": "alamotte1956",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
